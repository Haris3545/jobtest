# Postgres connection string (used for both local dev and production).
# Free tier, no card required: https://neon.tech — create a project, then
# copy the "Connection string" it gives you (starts with postgresql://).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required for CV tailoring, cover letters, prep briefs, ATS scoring, discovery.
ANTHROPIC_API_KEY=

# Free tier, no card required: https://tavily.com — used for company research,
# prep briefs, and the role-discovery / watchlist features.
TAVILY_API_KEY=

# Optional. If set, deadline reminders are also emailed via Resend
# (https://resend.com free tier). If unset, reminders are in-app + browser only.
RESEND_API_KEY=
REMINDER_EMAIL_TO=
